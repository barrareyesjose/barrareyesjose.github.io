---
// src/components/Header.astro
// Barra de navegación fija con barra de progreso de lectura.
// Los enlaces usan rutas absolutas ("/#stack") para que funcionen
// también desde las páginas de proyectos.
const path = Astro.url.pathname;
// Marca "Proyectos" como activo cuando estamos dentro de /proyectos/
const enProyectos = path.startsWith('/proyectos');
---
<header class="site-header">
  <nav class="container nav" aria-label="Principal">
    <a href="/" class="brand">
      <!-- Ícono de base de datos (SVG en línea, decorativo) -->
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse>
        <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path>
        <path d="M4 11v6c0 1.7 3.6 3 8 3"></path>
        <path d="M16 17h5M18.5 14.5v5"></path>
      </svg>
      José Barra
    </a>
    <div class="links">
      <a href="/proyectos/" aria-current={enProyectos ? 'page' : undefined}>Proyectos</a>
      <a href="/#stack">Stack</a>
      <a href="/#contacto" class="btn btn-primary cta">Contacto</a>
    </div>
  </nav>
  <!-- Barra de progreso: su ancho lo actualiza reveal.js según el scroll -->
  <div class="progress" aria-hidden="true"><div class="progress-bar" data-progress></div></div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid #1C2733;
  }
  .nav { height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-display); font-weight: 700; font-size: 18px;
    color: var(--text); text-decoration: none;
  }
  .brand svg { color: var(--accent); }
  .links { display: flex; align-items: center; gap: 4px; }
  .links a:not(.cta) { color: var(--muted); text-decoration: none; font-size: 14px; padding: 12px; }
  .links a:not(.cta):hover, .links a[aria-current='page'] { color: var(--text); }
  .cta { margin-left: 8px; padding: 10px 16px; font-size: 14px; }
  .progress { height: 2px; background: var(--surface-2); }
  .progress-bar { height: 2px; width: 0; background: var(--accent); }

  /* En pantallas angostas se oculta "Stack" para que quepa */
  @media (max-width: 560px) {
    .links a[href='/#stack'] { display: none; }
  }
</style>
