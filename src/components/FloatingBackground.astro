---
// src/components/FloatingBackground.astro
// Fondo animado: bases de datos, nubes (fuentes en la nube), carpetas y
// archivos que flotan hacia arriba.
//
// Cómo funciona:
//  - Se generan ~30 íconos SVG con posiciones, tamaños y velocidades
//    "aleatorias" pero fijas (usamos una semilla, así el sitio siempre se
//    ve igual y no cambia entre compilaciones).
//  - Hay 3 capas de profundidad: lejos (chicos, tenues, lentos),
//    medio y cerca (grandes, más visibles, más rápidos). Eso da sensación
//    de profundidad sin usar efectos costosos.
//  - La animación es 100% CSS (sin JavaScript): el navegador la mueve con
//    la GPU, así que no afecta el rendimiento del scroll.
//  - Si la persona tiene activado "reducir movimiento" en su sistema,
//    los íconos quedan quietos.

// Generador pseudo-aleatorio con semilla (algoritmo mulberry32)
function crearAleatorio(semilla: number) {
  return function () {
    semilla |= 0;
    semilla = (semilla + 0x6d2b79f5) | 0;
    let t = Math.imul(semilla ^ (semilla >>> 15), 1 | semilla);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = crearAleatorio(2026);
const entre = (min: number, max: number) => min + (max - min) * rnd();

// Tipos de ícono que pueden aparecer (los repetidos aparecen más seguido)
const tipos = ['db', 'folder', 'file', 'sql', 'csv', 'db', 'folder', 'pbix', 'file', 'py', 'cloud', 'cloud-db', 'cloud-up', 'cloud', 'cloud-db', 'cloud-up'];

// Capas de profundidad: [cantidad, tamaño mín, tamaño máx, opacidad, duración mín, duración máx]
const capas = [
  { n: 12, sMin: 22, sMax: 34, o: 0.13, dMin: 70, dMax: 95 },  // lejos
  { n: 11, sMin: 40, sMax: 56, o: 0.2, dMin: 48, dMax: 65 }, // medio
  { n: 7, sMin: 64, sMax: 88, o: 0.28, dMin: 32, dMax: 44 },  // cerca
];

// Arma la lista de íconos con todas sus propiedades
const items = capas.flatMap((c) =>
  Array.from({ length: c.n }, () => {
    const d = entre(c.dMin, c.dMax);   // segundos que tarda en cruzar la pantalla
    const r0 = entre(-25, 25);         // rotación inicial
    return {
      tipo: tipos[Math.floor(rnd() * tipos.length)],
      x: entre(2, 96).toFixed(1),      // posición horizontal (% del ancho)
      y: entre(5, 90).toFixed(1),      // posición fija si se reduce el movimiento
      s: Math.round(entre(c.sMin, c.sMax)),
      o: c.o,
      d: d.toFixed(1),
      delay: (-entre(0, d)).toFixed(1), // negativo: ya están repartidos al cargar
      r0: r0.toFixed(1),
      r1: (r0 + entre(-50, 50)).toFixed(1), // rotación final (giro suave)
      sw: Math.round(entre(8, 34)),     // amplitud del vaivén lateral (px)
      swd: entre(5, 11).toFixed(1),     // duración del vaivén (s)
      acento: rnd() < 0.55,             // celeste o gris
    };
  })
);

// Etiqueta que se dibuja dentro de los íconos de archivo con tipo
const etiquetas: Record<string, string> = { sql: 'SQL', csv: 'CSV', pbix: 'PBIX', py: '.PY' };
---
<div class="floating-bg" aria-hidden="true">
  {items.map((it) => (
    <div
      class:list={['fl', it.acento ? 'is-accent' : 'is-muted']}
      style={`--x:${it.x}%;--y:${it.y}%;--s:${it.s}px;--o:${it.o};--d:${it.d}s;--delay:${it.delay}s;--r0:${it.r0}deg;--r1:${it.r1}deg;--sw:${it.sw}px;--swd:${it.swd}s`}
    >
      <div class="sway">
        {it.tipo === 'db' && (
          // Base de datos: cilindro de 3 niveles
          <svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" /><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" /></svg>
        )}
        {it.tipo === 'cloud' && (
          // Nube: fuente de datos en la nube
          <svg viewBox="0 0 24 24"><path d="M17.5 19H8.5a5 5 0 1 1 1.2-9.86A6 6 0 0 1 21 11.6 3.8 3.8 0 0 1 17.5 19z" /></svg>
        )}
        {it.tipo === 'cloud-db' && (
          // Nube con una base de datos dentro (base de datos en la nube)
          <svg viewBox="0 0 24 24"><path d="M17.5 19H8.5a5 5 0 1 1 1.2-9.86A6 6 0 0 1 21 11.6 3.8 3.8 0 0 1 17.5 19z" /><ellipse cx="13" cy="12.4" rx="2.8" ry="1" /><path d="M10.2 12.4v2.6c0 .55 1.25 1 2.8 1s2.8-.45 2.8-1v-2.6" /></svg>
        )}
        {it.tipo === 'cloud-up' && (
          // Nube con flecha: datos que se cargan / sincronizan
          <svg viewBox="0 0 24 24"><path d="M17.5 19H8.5a5 5 0 1 1 1.2-9.86A6 6 0 0 1 21 11.6 3.8 3.8 0 0 1 17.5 19z" /><path d="M13 16.5v-5M10.8 13.6 13 11.4l2.2 2.2" /></svg>
        )}
        {it.tipo === 'folder' && (
          // Carpeta
          <svg viewBox="0 0 24 24"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z" /><path d="M3 10h18" /></svg>
        )}
        {it.tipo === 'file' && (
          // Archivo genérico con líneas de texto
          <svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><path d="M8.5 13h7M8.5 16.5h5" /></svg>
        )}
        {etiquetas[it.tipo] && (
          // Archivo con su extensión escrita (SQL, CSV, PBIX, .PY)
          <svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><text x="12" y="17.2" text-anchor="middle">{etiquetas[it.tipo]}</text></svg>
        )}
      </div>
    </div>
  ))}
</div>

<style>
  /* Capa fija detrás de todo el contenido */
  .floating-bg {
    position: fixed; inset: 0; z-index: 0;
    overflow: hidden; pointer-events: none; /* no interfiere con clics */
  }

  /* Cada ícono sube desde abajo de la pantalla hasta salir por arriba */
  .fl {
    position: absolute; left: var(--x); top: 0;
    width: var(--s); height: var(--s);
    opacity: var(--o);
    animation: subir var(--d) linear var(--delay) infinite;
    will-change: transform;
  }
  @keyframes subir {
    from { transform: translate3d(0, 110vh, 0) rotate(var(--r0)); }
    to   { transform: translate3d(0, -25vh, 0) rotate(var(--r1)); }
  }

  /* Vaivén lateral suave (como si flotaran en el agua) */
  .sway { width: 100%; height: 100%; animation: vaiven var(--swd) ease-in-out infinite alternate; }
  @keyframes vaiven {
    from { transform: translateX(calc(var(--sw) * -1)); }
    to   { transform: translateX(var(--sw)); }
  }

  svg { width: 100%; height: 100%; display: block; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  svg text { fill: currentColor; stroke: none; font-family: var(--font-mono); font-size: 4.4px; font-weight: 500; }
  .is-accent { color: var(--accent); }
  .is-muted { color: #8796A5; }

  /* Movimiento reducido: íconos quietos, repartidos por la pantalla */
  @media (prefers-reduced-motion: reduce) {
    .fl { animation: none; top: var(--y); transform: rotate(var(--r0)); }
    .sway { animation: none; }
  }
</style>
