---
// src/pages/index.astro
// Portada: presentación, proyectos destacados, stack y contacto.
// El fondo negro con íconos flotando se activa con <Base home>.
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { contacto } from '../data/site.js';
import { svgLogo, svgSqlDatabase } from '../data/logos.js';
import { fotoJose } from '../data/foto.js';

// Proyectos ordenados por el campo "orden"; en la portada se muestran 2
const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
const destacados = proyectos.slice(0, 2);

// Íconos de los botones de contacto (un solo color: toman el color del texto del botón)
const iconoGithub = svgLogo('simple-icons', 'github', undefined, 20);
const iconoLinkedin = svgLogo('simple-icons', 'linkedin', undefined, 20);
// Sobre de correo (ícono de trazo simple)
const iconoCorreo = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6.5 9 6.5 9-6.5"/></svg>';

// Herramientas del stack, con sus logos oficiales (ver src/data/logos.js).
const stack = [
  { nombre: 'SQL', logos: [{ svg: svgSqlDatabase, alt: 'Base de datos SQL' }],
    detalle: 'PostgreSQL, MariaDB y DBeaver. JOINs, CTEs, funciones de ventana, vistas y procedimientos almacenados.' },
  { nombre: 'Power BI', logos: [{ svg: svgLogo('logos', 'microsoft-power-bi'), alt: 'Power BI' }],
    detalle: 'Modelado en estrella y dashboards para seguimiento de indicadores.' },
  { nombre: 'Python', logos: [{ svg: svgLogo('logos', 'python'), alt: 'Python' }],
    detalle: 'EDA, tests estadísticos, NLP, modelos predictivos con SHAP y automatización de reportes.' },
  { nombre: 'Excel', logos: [{ svg: svgLogo('vscode-icons', 'file-type-excel'), alt: 'Microsoft Excel' }],
    detalle: 'Análisis rápido, tablas dinámicas y reportes para el día a día.' },
  { nombre: 'Power Automate', logos: [{ svg: svgLogo('simple-icons', 'powerautomate', '#0066FF'), alt: 'Power Automate' }],
    detalle: 'Automatización de flujos repetitivos para liberar tiempo de análisis.' },
];
---
<Base home>
  <!-- ===== Portada ===== -->
  <section class="container hero" id="inicio">
    <div class="hero-text">
      <div class="eyebrow">Analista de datos · Business intelligence</div>
      <h1>Convierto bases de datos en decisiones.</h1>
      <p>
        Ingeniero Civil Industrial mención Informática (Universidad de La Frontera).
        Trabajo con SQL, Power BI y Python para pasar de datos crudos a modelos limpios,
        KPIs claros e insights que se pueden usar.
      </p>
      <div class="actions">
        <a href="/proyectos/" class="btn btn-primary">Ver proyectos</a>
        <a href="#contacto" class="btn btn-ghost">Contacto</a>
      </div>
    </div>

    <!-- Foto de José completa, con marco -->
    <figure class="photo">
      <img src={fotoJose} alt="José Barra presentando un proyecto frente a una audiencia" width="640" height="640" />
    </figure>
  </section>

  <!-- ===== Proyectos destacados ===== -->
  <section class="container section" id="proyectos">
    <div class="section-head reveal">
      <div class="eyebrow">Proyectos</div>
      <h2 class="section-title">Datos reales, problemas reales.</h2>
    </div>
    <div class="grid-2 reveal">
      {destacados.map((p) => <ProjectCard proyecto={p} />)}
    </div>
    <div class="reveal">
      <a href="/proyectos/" class="btn btn-ghost">Ver todos los proyectos →</a>
    </div>
  </section>

  <!-- ===== Stack ===== -->
  <section class="container section reveal" id="stack">
    <div class="section-head">
      <div class="eyebrow">Stack</div>
      <h2 class="section-title">Herramientas con las que trabajo.</h2>
    </div>
    <div class="stack">
      {stack.map((s) => (
        <div class="stack-item">
          <!-- Logos oficiales (alto fijo; el ancho se ajusta a cada logo) -->
          <div class="stack-logos">
            {s.logos.map((l) => <span class="logo" role="img" aria-label={l.alt} title={l.alt} set:html={l.svg} />)}
          </div>
          <h3>{s.nombre}</h3>
          <p>{s.detalle}</p>
        </div>
      ))}
    </div>
    <p class="note">→ En preparación: certificación Microsoft PL-300 (Power BI Data Analyst)</p>
  </section>

  <!-- ===== Contacto ===== -->
  <section class="contact" id="contacto">
    <div class="container contact-inner reveal">
      <div class="contact-text">
        <div class="eyebrow">Contacto</div>
        <h2 class="contact-title">¿Tienes datos que necesitan contar algo?</h2>
        <p>
          Busco mi primer rol como Analista de Datos, Analista BI o Business Analyst.
          Región de La Araucanía, Chile · abierto a remoto e híbrido.
        </p>
      </div>
      <div class="contact-links">
        <!-- Correo (destacado), LinkedIn y GitHub. Los datos vienen de src/data/site.js -->
        {contacto.email && (
          <a class="btn btn-primary" href={`mailto:${contacto.email}`} title={contacto.email}>
            <span class="btn-icon btn-icon-line" set:html={iconoCorreo} />
            Enviar correo
          </a>
        )}
        {contacto.linkedin ? (
          <a class="btn btn-ghost" href={contacto.linkedin} target="_blank" rel="noopener">
            <span class="btn-icon" set:html={iconoLinkedin} />
            LinkedIn
          </a>
        ) : (
          /* Sin link todavía: botón visible pero desactivado */
          <span class="btn btn-ghost is-disabled" aria-disabled="true" title="Próximamente">
            <span class="btn-icon" set:html={iconoLinkedin} />
            LinkedIn
          </span>
        )}
        {contacto.github && (
          <a class="btn btn-ghost" href={contacto.github} target="_blank" rel="noopener">
            <span class="btn-icon" set:html={iconoGithub} />
            GitHub
          </a>
        )}
        {contacto.email && <span class="mail-text">{contacto.email}</span>}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 120px; padding-bottom: 120px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center; }
  .hero-text { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .hero h1 { font-size: clamp(44px, 6.4vw, 88px); line-height: 1.02; letter-spacing: -0.03em; }
  .hero p { margin: 0; font-size: 19px; line-height: 1.6; color: var(--muted); max-width: 620px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }

  /* Foto de la portada: imagen completa con marco.
     El marco es un contorno celeste desplazado detrás de la foto (::before)
     que se acerca un poco al pasar el mouse. */
  .photo { position: relative; flex: 1 1 300px; max-width: 400px; margin: 0 auto 16px; }
  .photo::before {
    content: ''; position: absolute; inset: 0; z-index: 0;
    border: 1.5px solid var(--accent); border-radius: 16px; opacity: .75;
    transform: translate(16px, 16px);
    transition: transform .35s ease;
  }
  .photo:hover::before { transform: translate(8px, 8px); }
  .photo img {
    position: relative; z-index: 1;
    display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover;
    border-radius: 16px; border: 1px solid var(--line-strong);
    background: var(--bg);
  }
  /* En pantallas angostas el marco se desplaza menos, para no tocar el borde */
  @media (max-width: 560px) {
    .photo { margin-right: 10px; }
    .photo::before { transform: translate(10px, 10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo::before { transition: none; }
  }

  .section { padding-top: 120px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 40px; }
  .section-head { display: flex; flex-direction: column; gap: 12px; }
  .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 24px; }

  .stack { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 16px; }
  .stack-item { border: 1px solid var(--line); border-radius: 12px; padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .stack-item { background: #0A0D11; transition: border-color .2s ease, transform .2s ease; }
  .stack-item:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .stack-logos { display: flex; align-items: center; gap: 12px; height: 40px; margin-bottom: 4px; }
  .stack-logos .logo {
    display: flex; height: 36px;
    transform-origin: left center; /* crece hacia la derecha, sin salirse de la tarjeta */
    transition: transform .25s cubic-bezier(.34, 1.56, .64, 1); /* leve rebote al agrandarse */
  }
  /* Al pasar el mouse por la tarjeta, el ícono se agranda un poco */
  .stack-item:hover .logo { transform: scale(1.22); }
  @media (prefers-reduced-motion: reduce) {
    .stack-logos .logo { transition: none; }
  }
  .stack-logos :global(svg) { height: 36px; width: auto; display: block; }
  .stack-item h3 { font-size: 22px; }
  .stack-item p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--muted); }
  .note { margin: 0; font-family: var(--font-mono); font-size: 13px; color: var(--muted); }

  .contact { margin-top: 80px; border-top: 1px solid #1C2733; }
  .contact-inner { padding-top: 100px; padding-bottom: 100px; display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between; align-items: flex-end; }
  .contact-text { display: flex; flex-direction: column; gap: 16px; max-width: 640px; }
  .contact-title { font-size: clamp(36px, 5vw, 64px); line-height: 1.02; letter-spacing: -0.03em; }
  .contact-text p { margin: 0; font-size: 17px; line-height: 1.6; color: var(--muted); }
  .contact-links { display: flex; flex-direction: column; gap: 12px; min-width: 260px; }
  .contact-links .btn { justify-content: center; gap: 10px; }
  .contact-links .btn-ghost { background: var(--bg); } /* fondo sólido: los íconos flotantes no se ven a través */
  /* Ícono dentro del botón: hereda el color del texto (currentColor) */
  .btn-icon { display: flex; }
  .btn-icon :global(svg) { height: 20px; width: 20px; fill: currentColor; }
  .btn-icon-line :global(svg) { fill: none; } /* el sobre es de trazo, sin relleno */
  /* Botón desactivado (LinkedIn mientras no hay link) */
  .is-disabled { color: #5B6875; border-color: var(--line); cursor: not-allowed; } /* atenuado sin transparencia */
  .is-disabled:hover { transform: none; color: #5B6875; border-color: var(--line); }
  /* Dirección de correo visible bajo los botones, para copiarla fácil */
  .mail-text { text-align: center; font-family: var(--font-mono); font-size: 13px; color: var(--muted); user-select: all; }
</style>
